'CR1000X Series Datalogger
'LateralFlux_CR1000Xe Data Logger Program

'Date: 07/21/2026
'Program author: Lauren Wick

' Change Log:
' 08/10/2026 - Update Rad7 bytes from 108 to 120
' 08/11/2026 - Add LI-850 CO2/H2O/CellTemp/CellPres via RS-232 (COM1 = C1/C2)
'              LI-850 averages appended to FLUX_7810 table
' 08/13/2026 - Changed comms mode on C1 from TTL to RS-232
' 10/07/2026 - Added <RAW>FALSE</RAW> to output string in LI-850

'Declare Constants
Const RAD7NumParams = 23

'Declare Public Variables
Public PTemp, Batt_volt
Public Flag(10)

'RAD7 Variables, Naming conventions to match SERC SARGE headers
'Data table with field name and units here: https://durridge.com/documentation/RAD7%20Manual.pdf
'Data string that will be coming off of the Rad7
Public String_RAD7 As String * 2000
Public Rad7Bytes
Public Rad7raw(23) As String * 26
Public Rad7(23)
Dim k,

'Each record contains 23 fields
Alias Rad7(1) = Record_RAD7
Alias Rad7(2) = Year_RAD7
Alias Rad7(3) = Month_RAD7
Alias Rad7(4) = Day_Rad7
Alias Rad7(5) = Hour_Rad7
Alias Rad7(6) = Minute_Rad7
Alias Rad7(7) = Total_Counts_Rad7
Alias Rad7(8) = Live_Time_Rad7
Alias Rad7(9) = PER_TOT_A_Rad7
Alias Rad7(10) =PER_TOT_B_Rad7
Alias Rad7(11) =PER_TOT_C_Rad7
Alias Rad7(12) =PER_TOT_D_Rad7
Alias Rad7(13) =High_Voltage_Level_Rad7
Alias Rad7(14) =High_Voltage_Duty_Rad7
Alias Rad7(15) =Temp_sample_Rad7
Alias Rad7(16) =RH_sample_Rad7
Alias Rad7(17) =Leakage_Current_Rad7
Alias Rad7(18) =Battery_Volt_Rad7
Alias Rad7(19) =Pump_current_Rad7
Alias Rad7(20) =Flags_Byte_Rad7
Alias Rad7(21) =Radon_concentration_Rad7
Alias Rad7(22) =Radon_concentration_uncertainty_Rad7
Alias Rad7(23) =Units_Byt_Rad7
'Units declaration for RAD7 (Durridge)
Units(Record_RAD7) =  ### 'Ranges from 001 to 999
Units(Year_RAD7)= YY
Units(Month_RAD7 = MM
Units(Day_Rad7)= dd
Units(Hour_Rad7)= hh
Units(Minute_Rad7)= mm
Units(Total_Counts_Rad7) = integer 'Integer indicating total counts recorded during test
Units(Live_Time_Rad7)= minutes ' expressed in minutes
Units(PER_TOT_A_Rad7) = percent
Units(PER_TOT_B_Rad7) = percent
Units(PER_TOT_C_Rad7) = percent
Units(PER_TOT_D_Rad7) = percent
' These 4 windows will not always add up to 100% since counts can come into channels below or above these windows.
Units(High_Voltage_Level_Rad7)= Volts ' ranges from 2200-2300V
Units(High_Voltage_Duty_Rad7) = percent ' ranges from 0-100% usually between 10-20%
Units(Temp_sample_Rad7)= celcius ' check Rad7 setup
Units(RH_sample_Rad7)= percent' keep below 10%
Units(Leakage_Current_Rad7)= integer' keep below 20
Units(Battery_Volt_Rad7) = Volts ' check below 6
Units(Pump_current_Rad7) = mA '
'Ranges from 0-260mA.  Typically 40-180mA, depending on the pump.  Higher than normal values indicate a clogged filter or other obstruction, or a faulty pump.
Units(Flags_Byte_Rad7)= integer  ' check manual for definition
Units(Radon_concentration_Rad7)= Bq/m3
Units(Radon_concentration_uncertainty_Rad7)= Bq/m3
Units(Units_Byt_Rad7) = integer' see manual


