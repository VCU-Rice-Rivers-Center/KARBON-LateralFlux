Alias EXO2(2) = snn

'Declare Private Variables

'Define Data Tables
DataTable (Rad7Table,1,-1) 'Set table size to # of records, or -1 to autoallocate.
	'RAD7 Data Interval is 15 minutes
  DataInterval (0,15,Min,10)

  'Sample RAD7 Data Table
  Sample(1,Record_RAD7,Long)
  Sample(1,Year_RAD7,Long)
  Sample(1,Month_RAD7,Long)
  Sample(1,Day_Rad7,Long)
  Sample(1,Hour_Rad7,Long)
  Sample(1,Minute_Rad7, Long)
  Sample(1,Total_Counts_Rad7,FP2)
  Sample(1,Live_Time_Rad7,Long)
  Sample(1,PER_TOT_A_Rad7,FP2)
  Sample(1,PER_TOT_B_Rad7,FP2)
  Sample(1,PER_TOT_C_Rad7,FP2)
  Sample(1,PER_TOT_D_Rad7,FP2)
  Sample(1,High_Voltage_Level_Rad7, FP2)
  Sample(1,High_Voltage_Duty_Rad7,FP2)
  Sample(1,Temp_sample_Rad7, FP2)
  Sample(1,RH_sample_Rad7, FP2)
  Sample(1,Leakage_Current_Rad7,FP2)
  Sample(1,Battery_Volt_Rad7,FP2)
  Sample(1,Pump_current_Rad7,FP2)
  Sample(1,Flags_Byte_Rad7, Long)
  Sample(1,Radon_concentration_Rad7, IEEE4)
  Sample(1,Radon_concentration_uncertainty_Rad7, IEEE4)
  Sample(1,Units_Byt_Rad7,Long)

EndTable

'7810 Table - LI-850 averages appended
DataTable (FLUX_7810,Flag(9),-1)
  '7810 Data Interval 10 seconds
  DataInterval (0,10,Sec,100)
  Sample(1,TimeLong7810,Nsec)
  Sample (1,LI7810_time,Long)
  Sample (4,LI7810(1),IEEE4)
  Sample (43,LI7810(8),IEEE4)

  '--- LI-850 Averaged Measurements ---
  ' Average() accumulates all scan readings within each 10-sec output interval.
  ' NAN values (e.g. when LI-850 is not sending) are excluded from the average.
 ' Average(1,CO2_LI850,IEEE4,False)
  'Average(1,H2O_LI850,IEEE4,False)
  'Average(1,CellTemp_LI850,IEEE4,False)
  'Average(1,CellPres_LI850,IEEE4,False)
  
  Sample(1, CO2_LI850, IEEE4)
  Sample(1, H2O_LI850, IEEE4)
  Sample(1, CellTemp_LI850, IEEE4)
  Sample(1, CellPres_LI850, IEEE4)

EndTable

'Sontek Table
DataTable(SontekTable, Flag(6), -1)
  DataInterval (0,3,Min,10)
  Sample(1, SONTEK_ID, String) ' Q = VA
  Sample(1,Sample_number, FP2) ' water depth of user-defined channel
  Sample(1, yyyy, FP2)
  Sample(1,MM, FP2)
  Sample(1, dd, FP2)
  Sample(1, hh, FP2)
  Sample(1,Minute, FP2)
  Sample(1, ss, FP2) 
  Sample(1,Flowrate,IEEE4)
  Sample(1,Stage,IEEE4)
  Sample(1,Mean_velocity,IEEE4)
  Sample(1,Total_volume,IEEE4)
  Sample(1,Water_depth,IEEE4)
  Sample(1,Index_velocity,IEEE4)
  Sample(1,Cross_area,IEEE4)
  Sample(1,Water_temperature,IEEE4)
  Sample(1,System_status,IEEE4)
  Sample(1,Velocity_XZxc,IEEE4)
  Sample(1,Velocity_XZzc,IEEE4)
  Sample(1,Velocity_XZxL,IEEE4)
  Sample(1,Velocity_XZxR,IEEE4)
  Sample(1,Batt_Vol_Sontek,IEEE4)
  Sample(1,Pitch_angle,IEEE4)
  Sample(1,Roll_angle,IEEE4)
  Sample(1,Perc_submergance,IEEE4)
  Sample(1,IceScore,IEEE4)
EndTable

'EXO2 Table
DataTable (ExoTable, Flag(8), -1)
  DataInterval (0,6,Min,10)
  Sample (1, Date, IEEE4)
  Sample(1,Time,IEEE4)
  Sample(1,Chlorophyll_RFU,IEEE4)
  Sample(1,Chlorophyll_ugL,IEEE4)
  Sample(1,Conductivity,IEEE4)
  Sample(1,FDOM_QSU,IEEE4)
  Sample(1,FDOM_RFU,IEEE4)
  Sample(1,NLF_conductivity,IEEE4)
  Sample(1,ODO_sat,IEEE4)
  Sample(1,ODO_local,IEEE4)
  Sample(1,ODO_MgL,IEEE4)
  Sample(1,Pressure_psia,IEEE4)
  Sample(1,Salinity_PPT,IEEE4)
  Sample(1,Specific_Conductivity_uScm,IEEE4)
  Sample(1,BGA_PE_RFU,IEEE4)
  Sample(1,BGA_PE_ugL,IEEE4)
  Sample(1,TDS_mg_L,IEEE4)
  Sample(1,Turbidity_FNU,IEEE4)
  Sample(1,Wiper_Position_mv,IEEE4)
  Sample(1,pH,IEEE4)
  Sample(1,pH_mv,IEEE4)
  Sample(1,Temp_C,IEEE4)
  Sample(1,Depth_m,IEEE4)
  Sample(1, Battery_v,IEEE4)
  Sample(1, Cable_v,IEEE4)
  Sample(1, Wiper_Current_ma,IEEE4)
    
  Sample (1,sn,String)
  Sample (1,snn,String)
EndTable
'Define Subroutines
'Sub
	'EnterSub instructions here
'EndSub

SequentialMode
'Main Program
BeginProg
  TCPClose(101)

  'Flags for sensor-level control
  Flag(6) = -1 'SONTEK
  Flag(7) = -1 'RAD7
  Flag(8) = -1 'EXO
  Flag(9) = -1 '7810

  SerialOpen (COMRS232,9600,0,0,2048) 'Rad7 - 8 bit, no parity, 1 bit stop
	SerialFlush (COMRS232)
	
  SerialOpen (ComC5,9600,0,0,2000) 'Sontek
  SerialFlush (ComC5)
	
  SerialOpen (ComC7,9600,0,0,2000) 'EXO2
  SerialFlush (ComC7)

  '--- LI-850 Initialization ---
  ' Open COM1 (C1/C2 control ports) at 9600 baud, 8N1, no flow control
  ' Open ComC1: 9600 baud, 8N1, RS-232 mode
  SerialOpen (ComC1, 9600, 0, 0, 600, 0)
  Delay (0, 2, 2) ' Wait 2 seconds  
    
  ' Flush buffer  
  SerialFlush (ComC1)
 
  ' Send initial configuration string to LI-850   
  SerialOut (ComC1, "<LI850><CFG><OUTRATE>1</OUTRATE></CFG><RS232><STRIP>TRUE</STRIP><CO2>TRUE</CO2><H2O>TRUE</H2O><CELLTEMP>TRUE</CELLTEMP><CELLPRES>TRUE</CELLPRES><IVOLT>FALSE</IVOLT><FLOWRATE>FALSE</FLOWRATE><RAW>FALSE</RAW><ECHO>FALSE</ECHO></RS232></LI850>" + CHR(13) + CHR(10), "",3, 0)
  Delay (0, 1, 2)
  SerialFlush (ComC1)

Scan (10, Sec, 6, 0)
    ' Measure diagnostics
    PanelTemp (PTemp, 15000)
    Battery (Batt_volt)

    If Flag(9) = -1 Then
        ' 1. Check if socket is open; if invalid/closed (-1 or handle <= 0), attempt to open
        tcpip_socket_status7810 = SerialInChk(socket7810)

        If (tcpip_socket_status7810 = -1) Or (socket7810 <= 0) Then
            ' TCPOpen returns a handle (> 100) on success, or 0 on failure
            socket7810 = TCPOpen (IP7810, 7800, 1000, 1000) 'LI-7810 live data stream port confirmed as 7800
        EndIf

        ' 2. If socket is valid, check for bytes and read
        If socket7810 > 0 Then
            tcpip_socket_status7810 = SerialInChk(socket7810)

            ' If bytes are waiting in the buffer, read and parse
            If tcpip_socket_status7810 > 0 Then
                SerialInRecord (socket7810, DATA_string7810, &h44, 0, &h0A, NBR7810, 00) '&h44 = ASCII "D" - LI-COR instruments mark start of each data record with "D"
                SplitStr (LI7810_time, DATA_string7810, CHR(09), 1, 4)
                SplitStr (LI7810(1), DATA_string7810, CHR(09), 51, 4)
                TimeLong7810 = (LI7810_time - (Daysto1990 * Daystosec)) - utcoffset
            EndIf
        EndIf
    Else
        ' If Flag(9) is turned off, safely close the socket
        If socket7810 > 0 Then
            TCPClose(socket7810)
            socket7810 = 0
        EndIf
    EndIf

    '--- LI-850 Passive Read and Parse ---
    
    ' Check if bytes exist in the C1/C2 buffer
   
    NBR850 = SerialInChk(ComC1)
    If NBR850 > 0 Then   
    ' Read string up to the Line Feed (&H0A / CHR(10))
    ' Parameter 3 = 0 (no start header filter needed for strip mode) 
    'SerialInRecord (ComC1, DATA_string850, 0, 0, &H0A, NBR850, 00)  
    'SerialIn(DATA_string850, ComC1, 6, CHR(13) + CHR(10), NBR850)
    'SerialIn (DATA_string850,ComC1,6,CRLF,NBR850)
    ' Split space-delimited string ("414.23 9.876 25.34 101.3") into LI850 array
      
      SerialInRecord(ComC1, DATA_string850, &H0A, 0, &H0D0A, NBR850, 01)
      ' Strip leading/trailing spaces
  
      FirstByteAsASCII = ASCII(DATA_string850(1,1))
      SplitStr(LI850(1), DATA_string850, " ", 4, 0)
      SerialFlush(ComC1)
    
    EndIf

    CallTable Rad7Table
    CallTable FLUX_7810
    CallTable ExoTable
    CallTable SontekTable

    NextScan

  SlowSequence
    Scan (1, min, 0, 0)
      
      If TimeIntoInterval (0, 3, min) Then
        SerialOut (ComC7, "0" + CHR(13), "?Command", 3, 10) 'ComPort, Output String
        Delay (1, 500, mSec)
        SerialOut (ComC7, "ssn" + CHR(13) + CHR(10),"",1,0)
        Delay (1, 500, mSec)
        SerialIn (EXO2(2), ComC7, 100, &H0D0A, 2000) 'Save ssn to EXO2(2)
        
        SerialOut (ComC7, "0" + CHR(13), "?Command", 3, 10) 'Call to Exo2 and wait until it's ready for command
        Delay (1, 500, mSec)
        SerialOut (ComC7, "sn" + CHR(13) + CHR(10), "", 1, 0)
        Delay (1, 500, mSec)
        SerialIn (EXO2(1), ComC7, 100, &H0D0A, 2000)
        Delay (1, 500, mSec)
        
        SerialOut(ComC7, "0" + CHR(13), "?Command", 3, 10)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "para 52 54 194 193 4 228 227 237 211 214 212 20 12" + CHR(13) + CHR(10), "", 1, 0)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "0" + CHR(13), "?Command", 3, 10)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "data" + CHR(13) + CHR(10), "", 1, 0)
        Delay (1, 500, mSec)
        SerialIn (Sonde_data, ComC7, 100, &H0D0A, 1000)
        Delay (1, 500, mSec)
        
        SerialOut (ComC7, "0" + CHR(13), "?Command", 3, 10)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "para 6 218 226 110 223 190 229 18 17 1 22 28 230 239" + CHR(13) + CHR(10), "", 1, 0)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "0" + CHR(13), "?Command", 3, 10)
        Delay (1, 500, mSec)
        SerialOut (ComC7, "data" + CHR(13) + CHR(10), "", 1, 0)
        Delay (1, 500, mSec)
        SerialIn (Sonde_data2, ComC7, 100, &H0D0A, 2000)
        Delay (1, 500, mSec)
        
        pSonde_data2 = Sonde_data2
        
        pSonde_data = Sonde_data
        Sonde_data = Trim(Sonde_data)
        Sonde_data2 = Trim(Sonde_data2)
        
        SplitStr (EXO(1), Sonde_data, " ", 13, 0)
        SplitStr (EXO(14), Sonde_data2, " ", 14, 0)
        
        SerialFlush (ComC7)
        SerialClose (ComC7)
      EndIf
      
      If IfTime (0,3,min)
        sontek_serialIn = SerialInChk(ComC5)
        ' NEW START
        'SerialOpen (ComC3,9600,0,0,2000)
        If SerialInChk(ComC5) > 10
          SerialIn (Sontekdata,ComC5,100,13,200)
          'SerialInRecord (ComC5,Sonetekdata,0,108,&H0D + ">",Rad7bytes,100)'If Flag = True, exit loop.
          'Delay (1,500,mSec)       
          SplitStr (Sontekraw(),Sontekdata," ",26,5)
          SerialFlush (ComC5)
        EndIf
      
        ''SerialClose (ComC3)
        For k =  2 To 26
          Sontek(k)= CTYPE(Sontekraw(k),Float)
        Next k
        Sontek(1) = CTYPE(Sontekraw(1),String)
      EndIf  
        
      ' Send data command to Rad7 every 5 minutes
      If TimeIntoInterval (0, 5, min) Then
        SerialOut (COMRS232,CHR(3) + CHR(13),"",3,10)
        Delay (1, 500, mSec)
        SerialOut (COMRS232,CHR(3) + "Test Com" + CHR(13),"",1,0)
		    Delay (1, 20, Sec)
		    SerialInRecord (COMRS232,String_RAD7,0,120,&H0D + ">",Rad7Bytes,100)
		    SplitStr (Rad7raw(1),String_RAD7,",",23,5)
		    SerialFlush (COMRS232)

        For k = 1 To 23
          Rad7(k) = CTYPE(Rad7raw(k), Float)
        Next k
      EndIf
	  NextScan
EndProg
