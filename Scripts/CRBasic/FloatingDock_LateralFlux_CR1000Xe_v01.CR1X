Units System_status = unitless
Units Velocity_XZxc = m/s
Units Velocity_XZzc = m/s
Units Velocity_XZxL = m/s
Units Velocity_XZxR = m/s
Units Batt_Vol_Sontek = volts
Units Pitch_angle = degrees
Units Roll_angle = degrees
Units Perc_submergance = percent
Units IceScore = integer

