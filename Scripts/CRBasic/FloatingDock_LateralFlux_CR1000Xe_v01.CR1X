Alias Sontek(4) = MM ' 
Alias Sontek(5) = dd
Alias Sontek(6) = hh
Alias Sontek(7) = Minute
Alias Sontek(8) = ss 
Alias Sontek(9) = Flowrate ' Q = VA
Alias Sontek(10) = Stage ' water depth of user-defined channel
Alias Sontek(11) = Mean_velocity
Alias Sontek(12) = Total_volume ' Q * time
Alias Sontek(13) = Water_depth
Alias Sontek(14) = Index_velocity
Alias Sontek(15) = Cross_area
Alias Sontek(16) = Water_temperature
