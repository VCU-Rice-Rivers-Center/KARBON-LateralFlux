'Constants to convert unix time to local time
'Public TimeLong7820 As Long
Public TimeLong7810 As Long

'--- LI-850 Variables ---
' RS-232: 9600 baud, 8 data bits, no parity, 1 stop bit
' Connect LI-850 RS-232 port to CR1000X COM1 (control ports C1/C2)
' STRIP mode enabled: LI-850 outputs space-delimited values (no XML tags)
' Output field order configured below: CO2, H2O, CELLTEMP, CELLPRES
Public LI850(4)
Public DATA_string850 As String * 300
Public NBR850 As Long
Public FirstByteAsASCII As Long

Alias LI850(1) = CellTemp_LI850
Alias LI850(2) = CellPres_LI850
Alias LI850(3)= CO2_LI850
Alias LI850(4) = H2O_LI850

Units(CO2_LI850)     = ppm
Units(H2O_LI850)     = mmol/mol
Units(CellTemp_LI850)= Celsius
Units(CellPres_LI850)= kPa

ConstTable (NewConstTable)
  Const Scan_interval = 100 '200 mSec 100 mSec 50 mSec
  Const Daystosec  = 86400
  Const Daysto1990 = 7305   ' from 1 January 1970
  Const utcoffset  = 21600 ' utc offset in seconds - this is important for
EndConstTable

'--- Sontek ADCP Variables ---'

Public Sontekdata As String * 2000
Public Sontekbytes
Public Sontekraw(26) As String *26,
Public Sontek(26)
Public SONTEK_ID As String *10
Public sontek_serialIn


' see page 96 Table 2 of Sontek IQ manual
'Alias Sontek(1) = SONTEK_ID ' Q = VA
Alias Sontek(2) = Sample_number ' water depth of user-defined channel
